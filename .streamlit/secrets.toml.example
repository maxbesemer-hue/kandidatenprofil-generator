# VORLAGE für Geheimnisse (Secrets). NICHT die echten Werte hier eintragen und
# committen -- diese Datei dient nur als Muster.
#
# LOKALE NUTZUNG:
#   Kopiere diese Datei zu "secrets.toml" (Endung .example weglassen) und trage
#   deinen Anthropic-API-Key ein. Alternativ speichert die App den Key beim
#   ersten Eingeben automatisch selbst.
#
# GEHOSTETE NUTZUNG (Streamlit Community Cloud o.ä.):
#   Diese Werte NICHT ins Repo legen, sondern im Hosting-Dienst unter
#   "Secrets" eintragen. Beide Werte zusammen aktivieren dort automatisch den
#   geschützten Modus: Passwortabfrage + zentraler KI-Zugang (die Nutzer sehen
#   dann kein Key-Feld und brauchen selbst keinen Key).
#
# WICHTIG: secrets.toml enthält ein Geheimnis. Nicht per E-Mail verschicken,
# nicht in geteilte Cloud-Ordner legen, nicht ins Repo committen.

# Dein Anthropic-API-Key (beginnt mit sk-ant-...). Über dieses Konto wird die
# KI-Nutzung abgerechnet.
ANTHROPIC_API_KEY = "sk-ant-DEIN-ECHTER-KEY"

# Nur für die gehostete Version: Zugangspasswort für die App. Wer die App-URL
# öffnet, muss dieses Passwort eingeben. Frei wählbar. Lokal einfach weglassen.
APP_PASSWORD = "ein-gutes-passwort-vergeben"
